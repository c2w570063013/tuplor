{
  "name": "pgstudio",
  "private": true,
  "version": "0.1.0",
  "description": "PG Studio — a beautiful, free PostgreSQL management tool",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "app": "node scripts/launch.mjs",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:smoke": "node scripts/desktop.mjs smoke",
    "desktop:assets": "node scripts/desktop.mjs assets",
    "license": "node desktop/scripts/license.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3"
  }
}
