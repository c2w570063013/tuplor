{
  "name": "@pgstudio/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --out-dir dist --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@types/pg-cursor": "^2.7.2",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "pg-query-stream": "^4.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
