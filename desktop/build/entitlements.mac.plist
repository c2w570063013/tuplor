<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the app and its Electron helpers (renderer, GPU and the
  utility process that runs the bundled Fastify server).

  * allow-jit / allow-unsigned-executable-memory: V8 (Chromium renderer and the Node-based
    utility process running server/index.mjs) generates machine code at runtime.
  * disable-library-validation: Electron's helpers load Electron Framework at runtime; required
    for ad-hoc signed test builds, and keeps any future native module loadable.

  Not needed: network client/server entitlements (only apply to App Sandbox, which we don't
  use), allow-dyld-environment-variables. The server has no native modules (pg-native is
  excluded) and only spawns external CLI tools (pg_dump, pg_restore, psql) as separate
  processes, which needs no entitlement.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
