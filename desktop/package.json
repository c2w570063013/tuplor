{
  "name": "pgstudio-desktop",
  "productName": "PG Studio",
  "private": true,
  "version": "0.1.0",
  "description": "PG Studio — a beautiful, free PostgreSQL management tool",
  "author": "PG Studio",
  "main": "src/main.cjs",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "icon": "node scripts/make-icon.mjs",
    "start": "electron .",
    "dev": "node scripts/stage.mjs && electron .",
    "dist": "node scripts/stage.mjs && electron-builder --mac --arm64 --publish never"
  },
  "build": {
    "appId": "app.pgstudio",
    "productName": "PG Studio",
    "copyright": "PG Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out/server",
        "to": "server"
      },
      {
        "from": "out/web",
        "to": "web"
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "artifactName": "PG-Studio-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "PG Studio ${version}",
      "artifactName": "PG-Studio-${version}-${arch}.${ext}"
    },
    "electronLanguages": [
      "en",
      "en_GB"
    ]
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
