---
// Brand mark: a generic database glyph (deliberately not the PostgreSQL elephant).
// Same artwork as public/favicon.svg.
interface Props { size?: number }
const { size = 28 } = Astro.props;
const id = `lg${Math.random().toString(36).slice(2, 8)}`;
---
<svg class="logo" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7c8cff" />
      <stop offset="1" stop-color="#4f46e5" />
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="15" fill={`url(#${id})`} />
  <g fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <ellipse cx="32" cy="19" rx="14" ry="5.5" />
    <path d="M18 19v26c0 3 6.3 5.5 14 5.5s14-2.5 14-5.5V19" />
    <path d="M18 32c0 3 6.3 5.5 14 5.5S46 35 46 32" />
  </g>
</svg>
