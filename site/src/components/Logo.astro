---
// Brand mark: a table whose header row + middle column form a "T" (deliberately not the PostgreSQL elephant).
// Same artwork as public/favicon.svg.
interface Props { size?: number }
const { size = 28 } = Astro.props;
const id = `lg${Math.random().toString(36).slice(2, 8)}`;
---
<svg class="logo" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#14b8a6" />
      <stop offset="1" stop-color="#6366f1" />
    </linearGradient>
    <clipPath id={`${id}c`}><rect x="13" y="13" width="38" height="38" rx="7" /></clipPath>
  </defs>
  <rect width="64" height="64" rx="15" fill={`url(#${id})`} />
  <g clip-path={`url(#${id}c)`} fill="#fff">
    <rect x="13" y="13" width="38" height="10" />
    <rect x="27.5" y="23" width="9" height="28" />
  </g>
  <path d="M13 37h14.5M36.5 37H51" stroke="#fff" stroke-opacity=".6" stroke-width="2.5" />
  <rect x="13" y="13" width="38" height="38" rx="7" fill="none" stroke="#fff" stroke-width="3" />
</svg>
